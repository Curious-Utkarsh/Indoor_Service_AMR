<?xml version="1.0" ?>
<robot name="mobi" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="laser_link">
        <inertial>
            <origin xyz="-0.154 0.0 -0.23" rpy="0.0 0.0 0.0"/>
            <mass value="0.5"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="-0.154 0.0 -0.23" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/lidar.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_brown"/>
        </visual>
        <collision>
            <origin xyz="-0.154 0.0 -0.23" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/lidar.stl" scale="0.001 0.001 0.001"/> <!--Kepp it as it is-->
            </geometry>
        </collision>
    </link>
    
    <joint name="laser_joint" type="fixed">
        <origin xyz="0.154 0.0 0.23" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="laser_link"/>
    </joint>
    
    
    <link name="camera_link">
        <inertial>
            <origin xyz="-0.15 0 -0.875" rpy="0.0 0.0 0.0"/>
            <mass value="0.5"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="-0.15 0 -0.875" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/camera.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_brown"/>
        </visual>
        <collision>
            <origin xyz="0.0 0 -0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.05 0.04 0.03"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="camera_joint" type="fixed">
        <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="chest_link"/>
        <child link="camera_link"/>
    </joint>
    
    <link name="camera_link_optical" />
    
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    
    
    <link name="imu_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.005"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.005"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="imu_joint" type="fixed">
        <origin xyz="0.02 -0.07 0.098" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

</robot>
