<?xml version="1.0"?>
<robot name="mobi" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="RobotSystem" type="system">

        <xacro:property name="PI" value="3.14159265359" />

        <!-- ros2_control Gazebo -->
        <xacro:if value="$(arg is_sim)">
            <hardware>
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </hardware>
        </xacro:if>

        <!-- ros2_control Real Robot -->
        <xacro:unless value="$(arg is_sim)">
            <hardware>
                <xacro:if value="${serial_port == '/dev/ttyUSB0'}">
                    <plugin>mobi_firmware/MobiInterface</plugin>
                    <param name="port">/dev/ttyUSB1</param>
                </xacro:if>
        
                <xacro:if value="${serial_port == '/dev/ttyUSB1'}">
                    <plugin>mobi_firmware/MobiInterface</plugin>
                    <param name="port">/dev/ttyUSB0</param>
                </xacro:if>
            </hardware>
        </xacro:unless>
        
        
        <!-- ros2_control Common Interfaces -->
         <!-- 60rpm = 6.3rad/sec-->
        <joint name="right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-6.3</param>
                <param name="max">6.3</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-6.3</param>
                <param name="max">6.3</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Make Changes Here also According to Joint Limits set in URDF-->
        <joint name="joint_1"> 
            <command_interface name="position">
            <param name="min">-0.350</param>
            <param name="max">0.0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="joint_2">
            <command_interface name="position">
            <param name="min">-1.0</param>
            <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="joint_3">
            <command_interface name="position">
            <param name="min">-0.535</param>
            <param name="max">0.400</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
        
    </ros2_control>

</robot>
