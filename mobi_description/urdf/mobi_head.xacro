<?xml version="1.0" ?>
<robot name="mobi" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="neckz_link">
        <inertial>
            <origin xyz="-0.0054 0.0 -0.92" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="-0.0054 0.0 -0.92" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/neck_z.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="-0.0054 0.0 -0.92" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/neck_z.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="joint_2" type="revolute"> <!-- neckz_joiny-->
        <origin xyz="0.0054 0.0 0.07" rpy="0.0 0.0 0.0"/>
        <parent link="chest_link"/>
        <child link="neckz_link"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.00" upper="1.00" effort="30.0" velocity="10.0"/>
    </joint>
    
    
    <link name="necky_link">
        <inertial>
            <origin xyz="-0.0046 0.0 -0.96" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="-0.0046 0.0 -0.96" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/neck_y.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="-0.0046 0.0 -0.96" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/neck_y.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="joint_3" type="revolute"> <!-- necky_joiny-->
        <origin xyz="0.00 0.0 0.04" rpy="0.0 0.0 0.0"/>
        <parent link="neckz_link"/>
        <child link="necky_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="-0.535" upper="0.400" effort="30.0" velocity="10.0"/>
    </joint>
    
    
    <link name="head_link">
        <inertial>
            <origin xyz="-0.092 0.0 -0.96" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="-0.092 0.0 -0.96" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/head.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="-0.092 0.0 -0.96" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/head.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="head_joint" type="fixed">
        <origin xyz="0.092 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="necky_link"/>
        <child link="head_link"/>
    </joint>

</robot>
