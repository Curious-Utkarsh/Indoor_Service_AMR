<?xml version="1.0" ?>
<robot name="mobi" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Load Simulated or Real Hardware Interfaces -->
    <xacro:arg name="is_sim" default="true"/> <!-- Overridden by hardware.launch -->
    <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>


    <link name="base_footprint"/>

    <link name="base_link">
        <inertial>
            <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="5.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <origin xyz="-0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_footprint"/>
        <child link="base_link"/>
    </joint>


    <link name="torso_link">
        <inertial>
            <origin xyz="0.15 0.0 -0.3" rpy="0.0 0.0 0.0"/>
            <mass value="3.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0.15 0.0 -0.3" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/torso.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0.15 0.0 -0.3" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/torso.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="torso_joint" type="fixed">
        <origin xyz="-0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="torso_link"/>
    </joint>


    <link name="right_wheel">
        <inertial>
            <origin xyz="0.0 0.2275 -0.06" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.2275 -0.06" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/right_wheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="mud_yellow"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <!-- <mesh filename="package://mobi_description/meshes/right_wheel.stl" scale="0.001 0.001 0.001"/> -->
                <sphere radius="0.06"/>
            </geometry>
        </collision>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="0.15 -0.2275 0.06" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>


    <link name="left_wheel">
        <inertial>
            <origin xyz="0.0 -0.2275 -0.06" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0.0 -0.2275 -0.06" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/left_wheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="mud_yellow"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <!-- <mesh filename="package://mobi_description/meshes/left_wheel.stl" scale="0.001 0.001 0.001"/> -->
                <sphere radius="0.06"/>
            </geometry>
        </collision>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="0.15 0.2275 0.06" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <link name="left_castor_wheel">
        <inertial>
            <origin xyz="0.355 -0.15 -0.045" rpy="0.0 0.0 0.0"/>
            <mass value="2.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0.355 -0.15 -0.045" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/left_castor.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="mud_yellow"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 -0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0.045"/>
            </geometry>
        </collision>
    </link>

    <joint name="left_castor_joint" type="fixed">
        <origin xyz="-0.205 0.15 0.05" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="left_castor_wheel"/>
    </joint>

    <link name="right_castor_wheel">
        <inertial>
            <origin xyz="0.355 0.15 -0.045" rpy="0.0 0.0 0.0"/>
            <mass value="2.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0.355 0.15 -0.045" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/right_castor.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="mud_yellow"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 -0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="right_castor_joint" type="fixed">
        <origin xyz="-0.205 -0.15 0.045" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="right_castor_wheel"/>
    </joint>

    <link name="front_castor_wheel">
        <inertial>
            <origin xyz="-0.1 0.0 -0.062" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="-0.1 0.0 -0.062" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mobi_description/meshes/front_castor.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="mud_yellow"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 -0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
        </collision>
    </link>

    <joint name="front_castor_joint" type="fixed">
        <origin xyz="0.25 0.0 0.062" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="front_castor_wheel"/>
    </joint>

</robot>
